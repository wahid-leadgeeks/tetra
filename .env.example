# Database (PGlite embedded Postgres or remote PostgreSQL URL)
DATABASE_URL=file:.data/tetra-pglite

# NextAuth / Auth.js Configuration
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Google OAuth 2.0 (for sign-in with Google)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Sheets Sync Connection (Environment Defaults)
# Extracted from URL: https://docs.google.com/spreadsheets/d/<spreadsheetId>/edit#gid=<sheetGid>
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=
GOOGLE_SHEET_GID=

# Google Service Account (optional for direct server-to-server sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Application Settings
DEFAULT_TIMEZONE=Asia/Jakarta
ALLOW_DEV_LOGIN=true
